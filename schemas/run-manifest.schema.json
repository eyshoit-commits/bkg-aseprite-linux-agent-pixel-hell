{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bkg:pixel-hell:run-manifest:1",
  "title": "Pixel Hell Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "deterministic_fingerprint", "recipe", "seed", "renderer", "outputs"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "deterministic_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "parent_run_id": { "type": ["string", "null"] },
    "recipe": { "type": "string", "minLength": 1 },
    "recipe_version": { "type": ["string", "null"] },
    "seed": { "type": "integer", "minimum": 0 },
    "style_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "script_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "outputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "quality_report_ref": { "type": ["string", "null"] }
  }
}
