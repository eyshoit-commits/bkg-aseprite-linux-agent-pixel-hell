{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bkg:pixel-hell:command-result:1",
  "title": "Pixel Hell CLI Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ok", "command", "exit_code"],
  "properties": {
    "schema_version": { "const": 1 },
    "ok": { "type": "boolean" },
    "command": { "type": "string", "minLength": 1 },
    "exit_code": { "type": "integer", "minimum": 0 },
    "run_id": { "type": ["string", "null"] },
    "result": {},
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": ["object", "array", "string", "number", "boolean", "null"] }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] }, "then": { "properties": { "error": { "type": "null" } } },
      "else": { "properties": { "error": { "type": "object" }, "exit_code": { "minimum": 1 } }, "required": ["error"] } }
  ]
}
